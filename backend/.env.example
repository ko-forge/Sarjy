DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# On the VPS, add the public IP with no port. Example: 203.0.113.10,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Docker Compose stores the database at /data/db.sqlite3. Leave unset for local runs.
# SQLITE_PATH=
# Add the Vercel site. Example: https://sarjy.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAI: LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL=gpt-4o-mini
# Z.ai GLM: LLM_BASE_URL=https://api.z.ai/api/paas/v4 and LLM_MODEL=glm-4.5-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.5-flash
# Optional. Set this to also offer GPT models in the header.
OPENAI_API_KEY=
